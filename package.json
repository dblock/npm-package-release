{
  "name": "npm-package-release",
  "version": "0.1.0",
  "description": "Composable, strongly typed npm release workflows with class-based steps and GitHub Actions interfaces.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "npr": "./bin/npr.js"
  },
  "files": [
    "dist/",
    "bin/",
    "assets/",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "DESIGN.md",
    "RELEASING.md",
    "docs/",
    "examples/"
  ],
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "test:coverage": "c8 --all --include=\"dist/**/*.js\" --include=\"bin/**/*.js\" --include=\"scripts/**/*.js\" --include=\"npr.config.js\" --exclude=\"dist/contracts.js\" --reporter=text --reporter=lcov npm test",
    "lint": "tsc --noEmit && tsc --project tsconfig.test.json && eslint . && eslint --config eslint.config-code-blocks.js \"**/*.md\" && node scripts/check-workflow-names.js",
    "pretest:package": "npm run build",
    "test:package": "node --test test/integration/*.test.js"
  },
  "dependencies": {
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "semver": "7.8.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/semver": "7.8.0",
    "@cspell/dict-en_us": "4.4.43",
    "@cspell/dict-software-terms": "5.4.9",
    "@eslint/js": "10.0.1",
    "@eslint/markdown": "8.0.3",
    "c8": "12.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-markdown-preferences": "0.43.0",
    "eslint-plugin-markdown-preferences-paragraph": "0.2.0",
    "eslint-plugin-prose-spellcheck": "0.1.2",
    "eslint-plugin-yml": "3.10.0",
    "title-case": "4.3.2",
    "yaml": "2.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dblock/npm-package-release.git"
  },
  "homepage": "https://github.com/dblock/npm-package-release#readme",
  "bugs": {
    "url": "https://github.com/dblock/npm-package-release/issues"
  },
  "keywords": [
    "npm",
    "release",
    "github-actions",
    "trusted-publishing"
  ],
  "license": "MIT",
  "author": "Daniel Doubrovkine",
  "publishConfig": {
    "access": "public"
  }
}
